diff --git a/app/src/split/bluetooth/service.c b/app/src/split/bluetooth/service.c
index 5bbed137..95bd2519 100644
--- a/app/src/split/bluetooth/service.c
+++ b/app/src/split/bluetooth/service.c
@@ -35,6 +35,43 @@ LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 #include <zmk/events/sensor_event.h>
 #include <zmk/sensors.h>
 
+#if IS_ENABLED(CONFIG_ZMK_BATTERY_REPORTING)
+// PATCH 23/08: characteristic mV pin — storage + read + ccc + notify hook.
+#include <zmk/events/battery_state_changed.h>
+static uint16_t battery_mv_value = 0;
+static ssize_t split_svc_read_batt_mv(struct bt_conn *conn, const struct bt_gatt_attr *attrs,
+                                      void *buf, uint16_t len, uint16_t offset) {
+    uint16_t le = sys_cpu_to_le16(battery_mv_value);
+    return bt_gatt_attr_read(conn, attrs, buf, len, offset, &le, sizeof(le));
+}
+
+static void split_svc_batt_mv_ccc(const struct bt_gatt_attr *attr, uint16_t value) {
+    LOG_DBG("batt_mv ccc value %d", value);
+}
+
+// Listener: khi battery_state_changed (moi 60s theo REPORT_INTERVAL) —
+// cap nhat storage va notify subscriber neu co
+static int split_svc_batt_mv_listener(const zmk_event_t *eh) {
+    const struct zmk_battery_state_changed *ev = as_zmk_battery_state_changed(eh);
+    if (ev == NULL) {
+        return ZMK_EV_EVENT_BUBBLE;
+    }
+    if (ev->millivolts != 0 && ev->millivolts != battery_mv_value) {
+        battery_mv_value = ev->millivolts;
+        uint16_t le = sys_cpu_to_le16(battery_mv_value);
+        // Notify theo UUID (conn=NULL → tat ca subscriber). attr truyen NULL —
+        // bt_gatt_notify_uuid signature (conn, uuid, attr, data, len).
+        static const struct bt_uuid_128 batt_mv_uuid =
+            BT_UUID_INIT_128(ZMK_SPLIT_BT_CHAR_BATTERY_MV_UUID);
+        bt_gatt_notify_uuid(NULL, (const struct bt_uuid *)&batt_mv_uuid, NULL, &le, sizeof(le));
+    }
+    return ZMK_EV_EVENT_BUBBLE;
+}
+
+ZMK_LISTENER(split_svc_batt_mv, split_svc_batt_mv_listener);
+ZMK_SUBSCRIPTION(split_svc_batt_mv, zmk_battery_state_changed);
+#endif
