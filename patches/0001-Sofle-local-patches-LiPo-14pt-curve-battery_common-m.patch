+    // de attach vao event cho widget OLED + split transport
+    {
+        struct sensor_value mv_val;
+        if (sensor_sample_fetch_chan(battery, SENSOR_CHAN_GAUGE_VOLTAGE) == 0 &&
+            sensor_channel_get(battery, SENSOR_CHAN_GAUGE_VOLTAGE, &mv_val) == 0) {
+            last_millivolts = (uint16_t)(mv_val.val1 * 1000 + mv_val.val2 / 1000);
