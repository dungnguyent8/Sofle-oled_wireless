diff --git a/app/module/drivers/sensor/battery/battery_common.c b/app/module/drivers/sensor/battery/battery_common.c
index 9afe2d5b..73335c71 100644
--- a/app/module/drivers/sensor/battery/battery_common.c
+++ b/app/module/drivers/sensor/battery/battery_common.c
@@ -30,14 +30,30 @@ int battery_channel_get(const struct battery_value *value, enum sensor_channel c
 }
 
 uint8_t lithium_ion_mv_to_pct(int16_t bat_mv) {
-    // Simple linear approximation of a battery based off adafruit's discharge graph:
-    // https://learn.adafruit.com/li-ion-and-lipoly-batteries/voltages
-
-    if (bat_mv >= 4200) {
+    // PATCH LOCAL (repo Sofle-oled_wireless, 23/08/2026): thay bang piecewise
+    // curve LiPo 1S cho pin 1S 5000mAh (2 nua keyboard). Linear cu
+    // `mv*2/15-459` sai +-10-15% o giua dai (plateau 3.7-3.9V).
+    // ⚠️ FILE TRONG zmk/ TREE — mat neu `west update` doi revision, phai
+    // re-apply (ghi chu trong docs/LOCAL_BUILD_SETUP.md).
+    static const uint16_t pts_mv[] = {3450, 3500, 3550, 3600, 3650, 3700,
+                                      3750, 3800, 3850, 3900, 3950, 4000, 4100, 4200};
+    static const uint8_t pts_pct[] = {0,  2,  5,  9,  16, 25,
+                                      36, 48, 60, 68, 74, 80, 92, 100};
+    const int n = (int)(sizeof(pts_mv) / sizeof(pts_mv[0]));
+
+    if (bat_mv >= (int16_t)pts_mv[n - 1]) {
         return 100;
-    } else if (bat_mv <= 3450) {
+    }
+    if (bat_mv <= (int16_t)pts_mv[0]) {
         return 0;
     }
-
-    return bat_mv * 2 / 15 - 459;
+    for (int i = 1; i < n; i++) {
+        if (bat_mv < (int16_t)pts_mv[i]) {
+            const uint32_t span_mv = pts_mv[i] - pts_mv[i - 1];
+            const uint32_t span_pct = pts_pct[i] - pts_pct[i - 1];
+            const uint32_t off = (uint32_t)bat_mv - pts_mv[i - 1];
+            return (uint8_t)(pts_pct[i - 1] + (off * span_pct) / span_mv);
+        }
+    }
+    return 100;
 }
