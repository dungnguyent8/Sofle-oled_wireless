     rc = sensor_sample_fetch_chan(battery, SENSOR_CHAN_VOLTAGE);
     if (rc != 0) {
@@ -85,17 +97,33 @@ static int zmk_battery_update(const struct device *battery) {
 
     uint16_t mv = voltage.val1 * 1000 + (voltage.val2 / 1000);
     state_of_charge.val1 = lithium_ion_mv_to_pct(mv);
+    last_millivolts = mv;
 
     LOG_DBG("State of change %d from %d mv", state_of_charge.val1, mv);
 #else
 #error "Not a supported reporting fetch mode"
 #endif
 
-    if (last_state_of_charge != state_of_charge.val1) {
+    // PATCH 23/08 (v2): event moi khi % doi HOAC mV doi >= 30mV —
+    // van de goc: event chi raise khi % doi, nen tren plateau LiPo
+    // (3.7-3.9V ~ chiem 70% dung luong) % khong doi hang gio →
+    // characteristic mV (listener tren event nay) khong bao gio notify,
+    // man hinh khong thay dien ap nua phai. 30mV = nguong tren noise
+    // ADC (~10-15mV) + voltage sag BLE TX, duoi do coi nhu khong doi
+    static uint16_t last_notified_mv = 0;
+    const bool soc_changed = (last_state_of_charge != state_of_charge.val1);
+    const int mv_diff = (int)last_millivolts - (int)last_notified_mv;
+    const bool mv_changed =
+        (last_millivolts != 0) && (mv_diff >= 30 || mv_diff <= -30);
+
+    if (soc_changed || mv_changed) {
         last_state_of_charge = state_of_charge.val1;
+        if (mv_changed) {
+            last_notified_mv = last_millivolts;
+        }
 
-        rc = raise_zmk_battery_state_changed(
-            (struct zmk_battery_state_changed){.state_of_charge = last_state_of_charge});
+        rc = raise_zmk_battery_state_changed((struct zmk_battery_state_changed){
+            .state_of_charge = last_state_of_charge, .millivolts = last_millivolts});
 
         if (rc != 0) {
             LOG_ERR("Failed to raise battery state changed event: %d", rc);
