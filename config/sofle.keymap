#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

// Override &mt/&lt phai nam NGOAI / { } block (devicetree syntax)
&mt {
    tapping-term-ms = <300>;
};

&lt {
    tapping-term-ms = <300>;
};

/ {
    // Activate ADJUST layer by pressing raise and lower

    // ==== Thumb phai (23/08 v3): key1 = HT NGOAI + TD TRONG ====
    // Da te ban cu (TD ngoai HT trong): TD khong capture phim khac khi
    // undecided → phim khac bam trong 300ms dau duoc keymap xu ly o
    // DEFAULT layer (PC nhan phim don) —.ht moi chiu capture milliseconds
    // sau thi mo layer → sai thu tu.
    // Dung chuan: HT NGOAI (undecided_hold_tap giam phim khac trong
    // captured_events[], replay sau khi mo LOWER) + TD TRONG lam tap-binding:
    //   giu >= 300ms hoac giu + phim khac  → mo 1 (combo tren lower)
    //   1 tap nhanh                        → to 0 (ve default)
    //   2 tap nhanh lien tiep              → to 1 (khoa lower)
    // (pattern = &lt cu cua ZMK — moi them khau dem tap o phan tap)
    behaviors {
        key1_td: key1_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&to 0>, <&to 1>;
        };

        key1_ht: key1_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            flavor = "hold-preferred";
            // hold = mo LOWER (param1 tu cho goi); tap = TD dem tap.
            // Param2 (cho TD) = 0 bi TD ignore (TD zero-param)
            bindings = <&mo>, <&key1_td>;
        };

        key4_td: key4_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&to 2>, <&adjust_direct_macro>;
        };
    };

    macros {
        // Bat lower + raise cung luc -> conditional_layer thay du dieu kien
        // -> tu kick hoat ADJUST. Thoat bang &to 0 (tat sach moi layer).
        adjust_direct_macro: adjust_direct_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&tog 1>, <&tog 2>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC       &kp N1  &kp N2        &kp N3    &kp N4               &kp N5                              &kp N6           &kp N7   &kp N8     &kp N9   &kp N0    &kp EQUAL
&mt CAPS TAB  &kp Q   &kp W         &kp E     &kp R                &kp T                               &kp Y            &kp U    &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT     &kp A   &kp S         &kp D     &kp F                &kp G                               &kp H            &kp J    &kp K      &kp L    &kp SEMI  &mt RIGHT_SHIFT APOS
&kp LCTRL     &kp Z   &kp X         &kp C     &kp V                &kp B        &kp C_MUTE    &to 1    &kp N            &kp M    &kp COMMA  &kp DOT  &kp FSLH  &mt RIGHT_SHIFT BACKSLASH
                      &kp LEFT_GUI  &kp LALT  &lt 2 K_APPLICATION  &lt 1 SPACE  &kp SPACE     &kp RET  &key1_ht 1 0     &kp BSPC  &kp DEL  &key4_td
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            label = "lower";

            // Bản đồ: ` Grave/Tilde | hàng 1 = F1-F11 | phải: Ins Home PgUp ↑ / PrSc ← ↓ → { Shift
            //         hàng 4 phải: PgDn / End. Phím cuối = trans (rơi về mt RSHFT BSLH)
            // Sensor-bindings giữ nguyên: trái virtual desktop, phải Ctrl+Tab.

            bindings = <
&kp GRAVE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                    &kp F6     &kp F7         &kp F8    &kp F9     &kp F10             &kp F11
&trans     &trans  &trans  &trans  &trans  &trans                    &kp INS    &kp PG_UP      &kp UP    &kp HOME   &trans              &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                    &kp PSCRN  &kp LEFT       &kp DOWN  &kp RIGHT  &kp LBRC            &mt RSHFT RIGHT_BRACE
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &to 0   &trans     &kp PAGE_DOWN  &trans    &kp END    &kp LS(LEFT_BRACE)  &mt (RIGHT_CONTROL) RS(RIGHT_BRACE)
                &trans  &trans  &trans  &trans  &trans    &trans  &trans     &trans         &trans    &trans
            >;

            // Encoder trai: Ctrl+Win+mui ten = chuyen Virtual Desktop Windows
            // Encoder phai: Ctrl+Tab / Ctrl+Shift+Tab = chuyen tab browser

            sensor-bindings = <&inc_dec_kp LC(LG(RIGHT)) LC(LG(LEFT)) &inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        raise_layer {
            label = "raise";

            // Layer PHÍM TẮT: phím giữ đúng chữ của shortcut gốc (C = Ctrl+C...)
            // Q slot = &kt LALT (Alt-Tab mode): nhấn 1 lần latch Alt → xoay encoder
            // phải (Tab) duyệt switcher → Enter chốt → nhấn lại Q để nhả Alt.
            // Trái hàng 2: W=tắt tab T=tab mới R=reload | Phải: Y=redo P=print
            // Home: A=chọn hết F=tìm G=tìm tiếp
            // Hàng 4: Z=undo X=cut C=copy V=paste B=bold
            // Không shortcut phổ quát → &trans (rơi về base)
            // Hàng BT giữ nguyên. Encoder trái: volume. Encoder phải: TAB (Alt-Tab mode).

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans        &trans     &trans     &trans      &trans      &trans
&kt LALT    &kp LC(W)     &trans        &kp LC(R)     &kp LC(T)     &trans                          &kp LC(Y)     &trans     &trans     &trans      &kp LC(P)   &trans
&trans      &kp LC(A)     &trans        &kp LC(F)     &kp LC(G)     &trans                          &trans        &trans     &trans     &trans      &trans      &trans
&trans      &kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(B)   &trans      &trans  &trans        &trans     &trans     &trans      &trans      &trans
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans        &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp TAB TAB>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            label = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                               &kp W  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                            &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                                      &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &rgb_ug RGB_TOG    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none              &to 0  &none  &none  &none  &to 0
            >;
        };
    };
};
